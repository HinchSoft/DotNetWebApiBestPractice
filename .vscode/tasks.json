{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/DotNetWebApiBestPractice.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/DotNetWebApiBestPractice.slnx"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/DotNetWebApiBestPractice.slnx"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch: DemoApi",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/Demo/src/DemoApi/DemoApi.csproj",
        "run",
        "--launch-profile",
        "https"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch: AppHost",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/Demo/src/DotNetWebApiBestPractice.AppHost/DotNetWebApiBestPractice.AppHost.csproj",
        "run",
        "--launch-profile",
        "https"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
