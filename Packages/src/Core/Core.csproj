<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <PackageId>RDH.Core</PackageId>
        <Title>Best Practices Core</Title>
        <Version>1.0.0</Version>
        <Authors>David Hinchliffe</Authors>
        <Product>Dot Net Web Api Best Practices</Product>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <AssemblyName>RDH.Core</AssemblyName>
        <RootNamespace>RDH.Core</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <None Include="readme.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.1.1"/>
        <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" Version="10.9.0" />
    </ItemGroup>

</Project>
