<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Hinchsoft.BestPractices.AspireDefaults</AssemblyName>
        <RootNamespace>Hinchsoft.BestPractices.AspireDefaults</RootNamespace>
        <PackageId>RDH.AspireDefaults</PackageId>
        <Description>RDH Framework hosted service and .NET Aspire startup support for database migrations and initialization.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
        <PackageReference Include="OpenTelemetry" Version="1.20.1" />
    </ItemGroup>

</Project>
