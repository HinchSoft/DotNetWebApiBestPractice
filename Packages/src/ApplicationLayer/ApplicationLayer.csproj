<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>RDH.ApplicationLayer</AssemblyName>
        <RootNamespace>RDH.ApplicationLayer</RootNamespace>
        <PackageId>RDH.ApplicationLayer</PackageId>
        <Description>RDH Framework application contracts, repository interfaces, unit-of-work abstractions, and pagination utilities.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" Version="10.9.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Telemetry" Version="10.9.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\Core.csproj"/>
    </ItemGroup>

</Project>
